@model ForgotPasswordDto
@{
    ViewData["Title"] = "ForgotPassword";
    Layout = "~/Views/Shared/_UILayout.cshtml";
}

<!doctype html>
<html lang="en">
<head>
	<title>Şifremi Unuttum - Elazığ Kuaförler ve Berberler Odası</title>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
	<link href="https://fonts.googleapis.com/css?family=Lato:300,400,700&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
	<link rel="stylesheet" href="~/Adminteması_connection/login-form-20/css/style.css">
	<style>
		body {
			font-family: "Lato", Arial, sans-serif;
			font-size: 18px;
			color: #fff;
			background-size: cover;
			background-repeat: no-repeat;
			background-attachment: fixed;
			position: relative;
		}

			body:before {
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				bottom: 0;
				background: rgba(0, 0, 0, 0.3);
			}

		.ftco-section {
			padding: 7em 0;
			position: relative;
			z-index: 1;
		}

		.heading-section {
			font-size: 3rem !important;
			color: #fff;
			font-weight: 600;
			margin-bottom: 20px;
		}

			.heading-section + p {
				font-size: 1.6rem !important;
				color: #fff;
				opacity: 0.9;
			}

		.login-wrap {
			background: rgba(255, 255, 255, 0.1);
			backdrop-filter: blur(10px);
			border-radius: 15px;
			border: 1px solid rgba(255, 255, 255, 0.2);
			box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
			padding: 3rem !important;
		}

			.login-wrap h3 {
				font-size: 1.8rem !important;
				color: #fff;
				font-weight: 600;
				margin-bottom: 30px;
				text-align: center;
			}

		.form-control {
			height: 65px !important;
			font-size: 1.3rem !important;
			padding: 0 20px !important;
			background: rgba(255, 255, 255, 0.9);
			border: 2px solid rgba(255, 255, 255, 0.3);
			border-radius: 8px;
			color: #333 !important;
			font-weight: 500;
			width: 100%;
		}

			.form-control::placeholder {
				font-size: 1.2rem;
				color: #666 !important;
				opacity: 0.8;
			}

			.form-control:focus {
				background: rgba(255, 255, 255, 0.95);
				border-color: #007bff;
				box-shadow: 0 0 10px rgba(0, 123, 255, 0.3);
				color: #333 !important;
			}

		.btn-primary {
			background: linear-gradient(45deg, #007bff, #0056b3);
			border: none;
			height: 65px !important;
			font-size: 1.4rem !important;
			font-weight: 600;
			border-radius: 8px;
			transition: all 0.3s ease;
		}

			.btn-primary:hover {
				background: linear-gradient(45deg, #0056b3, #004085);
				transform: translateY(-2px);
				box-shadow: 0 5px 15px rgba(0, 123, 255, 0.4);
			}

		.btn-secondary {
			background: linear-gradient(45deg, #6c757d, #545b62);
			border: none;
			height: 55px !important;
			font-size: 1.2rem !important;
			font-weight: 500;
			border-radius: 8px;
			transition: all 0.3s ease;
			color: #fff;
		}

			.btn-secondary:hover {
				background: linear-gradient(45deg, #545b62, #383d41);
				transform: translateY(-1px);
				box-shadow: 0 3px 10px rgba(108, 117, 125, 0.4);
			}

		.form-group {
			margin-bottom: 25px;
		}

		.alert {
			padding: 15px;
			margin-bottom: 20px;
			border: 1px solid transparent;
			border-radius: 8px;
			font-size: 1.1rem;
		}

		.alert-success {
			color: #155724;
			background-color: rgba(212, 237, 218, 0.9);
			border-color: #c3e6cb;
		}

		.alert-danger {
			color: #721c24;
			background-color: rgba(248, 215, 218, 0.9);
			border-color: #f5c6cb;
		}

		.info-text {
			background: rgba(23, 162, 184, 0.1);
			border: 1px solid rgba(23, 162, 184, 0.3);
			border-radius: 8px;
			padding: 20px;
			margin-bottom: 30px;
			color: #fff;
			font-size: 1.1rem;
			line-height: 1.6;
		}

		.back-link {
			color: #17a2b8 !important;
			font-size: 1.1rem;
			text-decoration: none;
			font-weight: 500;
			transition: all 0.3s ease;
		}

			.back-link:hover {
				color: #138496 !important;
				text-decoration: underline;
			}

		@@media (max-width: 768px) {
			.heading-section

		{
			font-size: 2.5rem !important;
		}

		.heading-section + p {
			font-size: 1.4rem !important;
		}

		.login-wrap {
			padding: 2rem !important;
		}

			.login-wrap h3 {
				font-size: 1.6rem !important;
			}

		.form-control {
			height: 55px !important;
			font-size: 1.1rem !important;
			padding: 0 15px !important;
		}

		.btn-primary {
			height: 55px !important;
			font-size: 1.2rem !important;
		}

		.btn-secondary {
			height: 50px !important;
			font-size: 1.1rem !important;
		}

		}
	</style>
</head>
<body class="img js-fullheight" style="background-image: url('@Url.Content("~/Adminteması_connection/login-form-20/images/bg.jpg")');">
	<section class="ftco-section">
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-md-8 text-center mb-5">
					<h2 class="heading-section">Şifre Sıfırlama</h2>
					<p>Elazığ Kuaförler ve Berberler Odası</p>
				</div>
			</div>
			<div class="row justify-content-center">
				<div class="col-md-8 col-lg-6">
					<div class="login-wrap p-0">
						<h3 class="mb-4 text-center">Şifreni mi Unuttun?</h3>

						<div class="info-text">
							<i class="fa fa-info-circle"></i>
							TC kimlik numaranızı ve kayıtlı e-posta adresinizi girin. Size şifre sıfırlama bağlantısı gönderilecektir.
						</div>

						@if (ViewData.ModelState.Any(x => x.Value.Errors.Count > 0))
						{
							<div class="alert alert-danger">
								<ul style="margin: 0; padding-left: 20px;">
									@foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
									{
										<li>@error.ErrorMessage</li>
									}
								</ul>
							</div>
						}

						@if (TempData["ErrorMessage"] != null)
						{
							<div class="alert alert-danger">
								<i class="fa fa-exclamation-circle"></i> @TempData["ErrorMessage"]
							</div>
						}

						<form method="post" asp-controller="Account" asp-action="ForgotPassword">
							<div class="form-group">
								<input type="text" asp-for="TC" class="form-control" placeholder="TC Kimlik Numarası"
									   pattern="\d{11}" title="TC kimlik numarası 11 rakamdan oluşmalıdır" maxlength="11" required>
								<span asp-validation-for="TC" class="text-danger"></span>
							</div>

							<div class="form-group">
								<input type="email" asp-for="Email" class="form-control" placeholder="E-posta Adresi" required>
								<span asp-validation-for="Email" class="text-danger"></span>
							</div>

							<div class="form-group">
								<button type="submit" class="form-control btn btn-primary submit px-3">
									<i class="fa fa-paper-plane"></i> Sıfırlama Bağlantısı Gönder
								</button>
							</div>
						</form>

						<div class="text-center mt-4">
							<a href="/Account/Login" class="back-link">
								<i class="fa fa-arrow-left"></i> Giriş Sayfasına Dön
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<script src="~/Adminteması_connection/login-form-20/js/jquery.min.js"></script>
	<script src="~/Adminteması_connection/login-form-20/js/popper.js"></script>
	<script src="~/Adminteması_connection/login-form-20/js/bootstrap.min.js"></script>
	<script src="~/Adminteması_connection/login-form-20/js/main.js"></script>
	<script>
		$(document).ready(function(){
			// TC kimlik no sadece rakam girişi
			$('#TC').on('input', function() {
				this.value = this.value.replace(/[^0-9]/g, '');
			});

			// Alert messages auto-hide
			setTimeout(function() {
				$('.alert').fadeOut('slow');
			}, 5000);
		});
	</script>
</body>
</html>

