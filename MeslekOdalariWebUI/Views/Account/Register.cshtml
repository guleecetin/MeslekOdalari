@model RegisterDto
@{
    Layout = null;
}

<!doctype html>
<html lang="en">
<head>
	<title>Elazığ Esnaf ve Sanatkarlar Odası - Kayıt</title>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
	<link href="https://fonts.googleapis.com/css?family=Lato:300,400,700&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
	<link rel="stylesheet" href="~/Registerteması_connection/login-form-20/css/style.css">
	<style>
		body {
			font-family: "Lato", Arial, sans-serif;
			font-size: 18px;
			color: #fff;
			background-size: cover;
			background-repeat: no-repeat;
			background-attachment: fixed;
			position: relative;
			z-index: 1;
		}

			body:before {
				content: '';
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				bottom: 0;
				background: rgba(0, 0, 0, 0.3);
				pointer-events: none;
				z-index: 0;
			}

		.ftco-section {
			padding: 4em 0;
			position: relative;
			z-index: 1;
		}

		.heading-section {
			font-size: 3.5rem !important;
			color: #fff;
			font-weight: 600;
			margin-bottom: 20px;
		}

			.heading-section + p {
				font-size: 1.8rem !important;
				color: #fff;
				opacity: 0.9;
			}

		.login-wrap {
			background: rgba(255, 255, 255, 0.1);
			backdrop-filter: blur(10px);
			border-radius: 15px;
			border: 1px solid rgba(255, 255, 255, 0.2);
			box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
			padding: 3rem !important;
			max-width: 1200px;
			width: 100%;
		}

			.login-wrap h3 {
				font-size: 2rem !important;
				color: #fff;
				font-weight: 600;
			}

		/* İki sütunlu form düzeni */
		.register-form {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 40px;
			margin-bottom: 30px;
		}

		.personal-info {
			border-right: 2px solid rgba(255, 255, 255, 0.2);
			padding-right: 30px;
		}

		.document-info {
			padding-left: 30px;
		}

		.section-title {
			font-size: 1.5rem;
			color: #fff;
			font-weight: 600;
			margin-bottom: 25px;
			text-align: center;
			padding-bottom: 15px;
			border-bottom: 2px solid rgba(255, 255, 255, 0.3);
		}

		.password-container {
			position: relative;
			display: flex;
			align-items: center;
		}

		.form-control {
			height: 60px !important;
			font-size: 1.2rem !important;
			padding: 0 20px !important;
			background: rgba(255, 255, 255, 0.9);
			border: 2px solid rgba(255, 255, 255, 0.3);
			border-radius: 8px;
			color: #333 !important;
			font-weight: 500;
			width: 100%;
			margin-bottom: 8px;
		}

		.password-container .form-control {
			padding: 0 50px 0 20px !important;
		}

		.form-control::placeholder {
			font-size: 1.1rem;
			color: #666 !important;
			opacity: 0.8;
		}

		.form-control:focus {
			background: rgba(255, 255, 255, 0.95);
			border-color: #007bff;
			box-shadow: 0 0 10px rgba(0, 123, 255, 0.3);
			color: #333 !important;
		}

		/* File input için özel stil */
		input[type="file"] {
			background: rgba(255, 255, 255, 0.95) !important;
			border: 2px dashed rgba(0, 123, 255, 0.5) !important;
			padding: 15px !important;
			border-radius: 8px;
			font-size: 0.95rem !important;
			color: #333 !important;
			transition: all 0.3s ease;
		}

			input[type="file"]:hover {
				border-color: #007bff !important;
				background: rgba(255, 255, 255, 1) !important;
			}

		/* File input label */
		.file-label {
			color: #fff;
			font-size: 1rem;
			font-weight: 500;
			margin-bottom: 8px;
			display: block;
		}

		.btn-primary {
			background: linear-gradient(45deg, #007bff, #0056b3);
			border: none;
			height: 65px !important;
			font-size: 1.4rem !important;
			font-weight: 600;
			border-radius: 8px;
			transition: all 0.3s ease;
			grid-column: 1 / -1; /* Buton her iki sütuna yayılsın */
			margin-top: 20px;
		}

			.btn-primary:hover {
				background: linear-gradient(45deg, #0056b3, #004085);
				transform: translateY(-2px);
				box-shadow: 0 5px 15px rgba(0, 123, 255, 0.4);
			}

		.field-icon {
			position: absolute;
			right: 15px;
			top: 50%;
			transform: translateY(-50%);
			z-index: 10;
			font-size: 1.3rem !important;
			color: #666;
			cursor: pointer;
			padding: 5px;
			transition: color 0.3s ease;
		}

			.field-icon:hover {
				color: #333;
			}

		.form-group {
			margin-bottom: 20px;
		}

		.login-link {
			text-align: center;
			margin-top: 20px;
		}

			.login-link a {
				color: #fff !important;
				text-decoration: none;
				font-size: 1.1rem;
			}

				.login-link a:hover {
					text-decoration: underline;
				}

		/* Responsive tasarım */
		@@media (max-width: 992px) {
			.register-form

		{
			grid-template-columns: 1fr;
			gap: 30px;
		}

		.personal-info {
			border-right: none;
			padding-right: 0;
			border-bottom: 2px solid rgba(255, 255, 255, 0.2);
			padding-bottom: 30px;
		}

		.document-info {
			padding-left: 0;
			padding-top: 10px;
		}

		.login-wrap {
			padding: 2rem !important;
		}

		}

		@@media (max-width: 768px) {
			.heading-section

		{
			font-size: 2.5rem !important;
		}

		.heading-section + p {
			font-size: 1.4rem !important;
		}

		.login-wrap h3 {
			font-size: 1.6rem !important;
		}

		.form-control {
			height: 55px !important;
			font-size: 1.1rem !important;
		}

		.btn-primary {
			height: 55px !important;
			font-size: 1.2rem !important;
		}

		.section-title {
			font-size: 1.3rem;
		}

		.file-label {
			font-size: 0.9rem;
		}

		}
	</style>
</head>
<body class="img js-fullheight" style="background-image: url('@Url.Content("~/Registerteması_connection/login-form-20/images/bg.jpg")');">
	<section class="ftco-section">
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-md-12 text-center mb-4">
					<h2 class="heading-section">Elazığ Esnaf ve Sanatkarlar Odası</h2>
					<p>Esnaf Kayıt Sayfası</p>
				</div>
			</div>
			<div class="row justify-content-center">
				<div class="col-12">
					<div class="login-wrap p-0">
						<form method="post" id="register-form" asp-controller="Account" asp-action="Register" enctype="multipart/form-data">

							<div class="register-form">
								<!-- Sol Taraf - Kişisel Bilgiler -->
								<div class="personal-info">
									<h4 class="section-title">
										<i class="fa fa-user"></i> Kişisel Bilgiler
									</h4>

									<div class="form-group">
										<input type="text" asp-for="TC" id="kimlikno" class="form-control" placeholder="TC Kimlik No" required
											   pattern="\d{11}" title="TC kimlik numarası 11 rakamdan oluşmalıdır" maxlength="11">
									</div>

									<div class="form-group">
										<input type="text" asp-for="NameSurname" id="name" class="form-control" placeholder="Ad Soyad" required>
									</div>

									<div class="form-group">
										<input type="email" asp-for="Email" id="email" class="form-control" placeholder="E-posta Adresi" required>
									</div>

									<div class="form-group">
										<input type="text" asp-for="UserName" id="username" class="form-control" placeholder="Kullanıcı Adı" required>
									</div>

									<div class="form-group">
										<div class="password-container">
											<input asp-for="Password" id="password-field" type="password" class="form-control" placeholder="Şifre" required>
											<i class="fa fa-eye field-icon toggle-password" data-target="#password-field"></i>
										</div>
									</div>
								</div>

								<!-- Sağ Taraf - İşyeri Belgeleri -->
								<div class="document-info">
									<h4 class="section-title">
										<i class="fa fa-file-text"></i> İşyeri Belgeleri
									</h4>

									<div class="form-group">
										<label for="CopyOfIDCard" class="file-label">
											<i class="fa fa-id-card"></i> Nüfus Cüzdanı Fotokopisi
										</label>
										<input type="file" asp-for="CopyOfIDCard" id="CopyOfIDCard" class="form-control" required accept=".pdf,.jpg,.jpeg,.png">
									</div>

									<div class="form-group">
										<label for="ResidenceCertificate" class="file-label">
											<i class="fa fa-home"></i> İkametgah Belgesi
										</label>
										<input type="file" asp-for="ResidenceCertificate" id="ResidenceCertificate" class="form-control" required accept=".pdf,.jpg,.jpeg,.png">
									</div>

									<div class="form-group">
										<label for="TaxPlate" class="file-label">
											<i class="fa fa-calculator"></i> Vergi Levhası
										</label>
										<input type="file" asp-for="TaxPlate" id="TaxPlate" class="form-control" required accept=".pdf,.jpg,.jpeg,.png">
									</div>

									<div class="form-group">
										<label for="BusinessOpeningLicense" class="file-label">
											<i class="fa fa-building"></i> İşyeri Açma ve Çalışma Ruhsatı
										</label>
										<input type="file" asp-for="BusinessOpeningLicense" id="BusinessOpeningLicense" class="form-control" required accept=".pdf,.jpg,.jpeg,.png">
									</div>

									<div class="form-group">
										<label for="RegistrationForm" class="file-label">
											<i class="fa fa-file-o"></i> Oda Kayıt Formu
										</label>
										<input type="file" asp-for="RegistrationForm" id="RegistrationForm" class="form-control" required accept=".pdf,.jpg,.jpeg,.png">
									</div>

									<div class="form-group">
										<label for="DiplomaOrCertification" class="file-label">
											<i class="fa fa-graduation-cap"></i> Diploma veya Mesleki Yeterlilik Belgesi
										</label>
										<input type="file" asp-for="DiplomaOrCertification" id="DiplomaOrCertification" class="form-control" required accept=".pdf,.jpg,.jpeg,.png">
									</div>

									<div class="form-group">
										<label for="TradesmanRegistryDeclaration" class="file-label">
											<i class="fa fa-list-alt"></i> Esnaf Sicil Beyannamesi
										</label>
										<input type="file" asp-for="TradesmanRegistryDeclaration" id="TradesmanRegistryDeclaration" class="form-control" required accept=".pdf,.jpg,.jpeg,.png">
									</div>

									<div class="form-group">
										<label for="SignatureDeclaration" class="file-label">
											<i class="fa fa-pencil"></i> İmza Beyannamesi
										</label>
										<input type="file" asp-for="SignatureDeclaration" id="SignatureDeclaration" class="form-control" required accept=".pdf,.jpg,.jpeg,.png">
									</div>
								</div>

								<!-- Kayıt Butonu -->
								<div class="form-group">
									<button type="submit" class="form-control btn btn-primary submit px-3">
										<i class="fa fa-user-plus"></i> Kayıt Ol
									</button>
								</div>
							</div>
						</form>

						<div class="login-link">
							<p>Zaten üye misiniz? <a href="/Account/Login" class="text-primary font-weight-bold">Giriş Yap</a></p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<script src="~/Registerteması_connection/login-form-20/js/jquery.min.js"></script>
	<script src="~/Registerteması_connection/login-form-20/js/popper.js"></script>
	<script src="~/Registerteması_connection/login-form-20/js/bootstrap.min.js"></script>
	<script src="~/Registerteması_connection/login-form-20/js/main.js"></script>
	<script>
		$(document).ready(function(){
			// Göz ikonu toggle işlevi
			$(".toggle-password").click(function() {
				console.log("Toggle password clicked");

				// Icon değiştirme
				$(this).toggleClass("fa-eye fa-eye-slash");

				// Target input field'ı bul
				var targetId = $(this).data("target");
				var input = $(targetId);

				// Input type'ını değiştir
				if (input.attr("type") === "password") {
					input.attr("type", "text");
				} else {
					input.attr("type", "password");
				}
			});

			// File input hover efekti für görsel iyileştirme
			$('input[type="file"]').on('change', function() {
				if (this.files && this.files.length > 0) {
					$(this).css('border-color', '#28a745');
				}
			});

			// TC Kimlik No sadece rakam girişi
			$('#kimlikno').on('input', function() {
				this.value = this.value.replace(/[^0-9]/g, '');
			});
		});
	</script>
</body>
</html>