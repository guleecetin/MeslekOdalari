@model List<MeslekOdalariWebUI.Models.RssItem>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_UILayout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

<div class="container-fluid">
    <!-- Header Section -->
    <div class="hero-section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8 mx-auto text-center">
                    <div class="hero-content">
                        <h1 class="hero-title">
                            📰 Güncel Haberler
                        </h1>
                        <p class="hero-subtitle">
                            Son Dakika Haberleri ve Güncel Gelişmeler
                        </p>
                        <div class="stats-row">
                            @if (ViewBag.TotalNews != null)
                            {
                                <span class="stat-item">
                                    <i class="fas fa-newspaper"></i>
                                    @ViewBag.TotalNews Haber
                                </span>
                            }
                            @if (ViewBag.ElazigNewsCount != null && ViewBag.ElazigNewsCount > 0)
                            {
                                <span class="stat-item">
                                    <i class="fas fa-map-marker-alt"></i>
                                    @ViewBag.ElazigNewsCount Elazığ Haberi
                                </span>
                            }
                            <span class="stat-item">
                                <i class="fas fa-clock"></i>
                                Anlık Güncelleme
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- News Section -->
    <div class="news-section">
        <div class="container">
            @if (ViewBag.ErrorMessage != null)
            {
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle"></i>
                            <strong>Bilgi:</strong> @ViewBag.ErrorMessage
                        </div>
                    </div>
                </div>
            }

            <div class="row">
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <div class="col-lg-6 col-md-12 mb-4">
                            <article class="news-card">
                                <div class="news-card-body">
                                    <h3 class="news-title">
                                        <a href="@Url.Action("NewsDetail", "Rss", new {
                                            url = item.Link,
                                            title = Uri.EscapeDataString(item.Title),
                                            description = Uri.EscapeDataString(item.Description ?? ""),
                                            date = item.PublishDate.ToString("yyyy-MM-dd HH:mm:ss")
                                        })" class="news-link">
                                            @item.Title
                                        </a>
                                    </h3>
                                    <p class="news-description">
                                        @if (!string.IsNullOrEmpty(item.Description))
                                        {
                                            @(item.Description.Length > 150 ? item.Description.Substring(0, 150) + "..." : item.Description)
                                        }
                                        else
                                        {
                                            <span class="text-muted">Detaylar için habere tıklayın...</span>
                                        }
                                    </p>
                                    <div class="news-meta">
                                        <span class="news-date">
                                            <i class="far fa-calendar-alt"></i>
                                            @item.PublishDate.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("tr-TR"))
                                        </span>
                                        <span class="news-time">
                                            <i class="far fa-clock"></i>
                                            @item.PublishDate.ToString("HH:mm")
                                        </span>
                                        @if (!string.IsNullOrEmpty(item.Author))
                                        {
                                            <span class="news-author">
                                                <i class="far fa-user"></i>
                                                @item.Author
                                            </span>
                                        }
                                    </div>
                                    <div class="news-actions">
                                        <a href="@Url.Action("NewsDetail", "Rss", new {
                                            url = item.Link,
                                            title = Uri.EscapeDataString(item.Title),
                                            description = Uri.EscapeDataString(item.Description ?? ""),
                                            date = item.PublishDate.ToString("yyyy-MM-dd HH:mm:ss")
                                        })" class="btn btn-primary btn-sm">
                                            <i class="fas fa-read"></i> Devamını Oku
                                        </a>
                                        <a href="@item.Link" target="_blank" class="btn btn-outline-secondary btn-sm">
                                            <i class="fas fa-external-link-alt"></i> Orijinal Haber
                                        </a>
                                    </div>
                                </div>
                            </article>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="loading-section">
                            <div class="loading-spinner">
                                <div class="spinner"></div>
                            </div>
                            <h3 class="loading-title">Haberler Yükleniyor...</h3>
                            <p class="loading-text">Güncel haberler getiriliyor, lütfen bekleyin.</p>
                        </div>
                    </div>
                }
            </div>

            <!-- Action Buttons -->
            <div class="row mt-4">
                <div class="col-12 text-center">
                    <div class="action-buttons">
                        <a href="@Url.Action("AllNews")" class="btn btn-lg btn-primary">
                            <i class="fas fa-globe"></i> Tüm Haberler
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: #f8f9fa;
        color: #333;
    }

    .container-fluid {
        padding: 0;
    }

    /* Hero Section */
    .hero-section {
        background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
        padding: 3rem 0;
        color: white;
        margin-bottom: 2rem;
    }

    .hero-content {
        text-align: center;
    }

    .hero-title {
        font-size: 2.5rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .hero-subtitle {
        font-size: 1.1rem;
        margin-bottom: 1.5rem;
        opacity: 0.9;
    }

    .stats-row {
        display: flex;
        justify-content: center;
        gap: 1.5rem;
        flex-wrap: wrap;
    }

    .stat-item {
        background: rgba(255,255,255,0.15);
        padding: 0.5rem 1rem;
        border-radius: 25px;
        font-size: 0.9rem;
        backdrop-filter: blur(10px);
    }

        .stat-item i {
            margin-right: 0.4rem;
        }

    /* News Section */
    .news-section {
        padding: 0 0 3rem;
        min-height: 60vh;
    }

    .news-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.08);
        transition: all 0.3s ease;
        height: 100%;
        border: 1px solid #e9ecef;
    }

        .news-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.12);
        }

    .news-card-body {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .news-title {
        font-size: 1.2rem;
        font-weight: 600;
        margin-bottom: 0.8rem;
        line-height: 1.4;
    }

    .news-link {
        color: #2c3e50;
        text-decoration: none;
        transition: color 0.3s ease;
    }

        .news-link:hover {
            color: #4a90e2;
            text-decoration: none;
        }

    .news-description {
        color: #6c757d;
        line-height: 1.5;
        margin-bottom: 1rem;
        font-size: 0.95rem;
        flex-grow: 1;
    }

    .news-meta {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        padding: 0.8rem 0;
        border-top: 1px solid #f1f3f4;
        border-bottom: 1px solid #f1f3f4;
        font-size: 0.85rem;
        color: #8e9aaf;
        margin-bottom: 1rem;
    }

    .news-date i, .news-time i, .news-author i {
        color: #4a90e2;
        margin-right: 0.3rem;
    }

    .news-actions {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .btn-sm {
        padding: 0.4rem 0.8rem;
        font-size: 0.8rem;
    }

    .action-buttons {
        display: flex;
        justify-content: center;
        gap: 1rem;
        flex-wrap: wrap;
        margin-top: 2rem;
    }

    /* Loading Section */
    .loading-section {
        text-align: center;
        padding: 4rem 2rem;
    }

    .loading-spinner {
        margin-bottom: 2rem;
    }

    .spinner {
        width: 50px;
        height: 50px;
        border: 3px solid #f3f3f3;
        border-top: 3px solid #4a90e2;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 0 auto;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    .loading-title {
        color: #2c3e50;
        margin-bottom: 0.5rem;
        font-weight: 500;
    }

    .loading-text {
        color: #6c757d;
    }

    /* Alert Styling */
    .alert {
        border: none;
        padding: 1rem;
        border-radius: 8px;
    }

    .alert-warning {
        background: #fff3cd;
        color: #856404;
        border: 1px solid #ffeaa7;
    }

    .alert i {
        margin-right: 0.5rem;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .hero-title {
            font-size: 2rem;
        }

        .hero-subtitle {
            font-size: 1rem;
        }

        .stats-row {
            gap: 1rem;
        }

        .stat-item {
            padding: 0.4rem 0.8rem;
            font-size: 0.8rem;
        }

        .news-card-body {
            padding: 1.2rem;
        }

        .news-meta {
            gap: 0.8rem;
        }

        .news-actions {
            flex-direction: column;
        }

        .action-buttons {
            flex-direction: column;
            align-items: center;
        }
    }

    @@media (max-width: 576px) {
        .hero-section {
            padding: 2rem 0;
        }

        .news-section {
            padding: 0 0 2rem;
        }
    }
</style>

